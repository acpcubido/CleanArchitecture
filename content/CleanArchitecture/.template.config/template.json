{
    "author": "ACP Cubido",
    "name": "ACP Cubido Clean Code Template",
    "shortName": "cubido-template",
    "tags": {
        "type": "solution",
        "language": "C#",
        "editorTreatAs": "solution"
    },
    "identity": "Cubido.CleanArchitecture.Template",
    "sourceName": "Cubido.Template",
    "primaryOutputs": [
        {
            "path": "Cubido.Template.slnx"
        }
    ],
    "symbols": {
        "IncludeFrontend": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "displayName": "Include Angluar Project",
            "description": "Include the Angular frontend project in the solution"
        },
        "IncludeMcpServer": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "displayName": "Include MCP Server",
            "description": "Include an MCP server with JWT Bearer Azure AD authentication"
        },
        "FriendlyName": {
            "type": "parameter",
            "datatype": "string",
            "displayName": "Azure friendly name",
            "description": "An azure friendly name for the projects (all lowercase, no numbers, no spaces)",
            "replaces": "cubido-template"
        },
        "HostIdentifier": {
            "type": "bind",
            "binding": "host:HostIdentifier"
        }
    },
    "sources": [
        {
            "source": "./",
            "modifiers": [
                {
                    "condition": "(!IncludeFrontend)",
                    "exclude": [ "src/Frontend/**/*" ]
                },
                {
                    "condition": "(!IncludeMcpServer)",
                    "exclude": [ "src/Web/Tools/*", "src/Web/AzureAdOptions.cs", "src/Web/McpTelemetryMiddleware.cs" ]
                },
                // workaround for Visual Studio stripping solution folders not needed in dotnet new CLI
                {
                    "condition": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")",
                    "exclude": [ "tests/Application.FunctionalTests/Application.FunctionalTests.csproj" ],
                    "rename": {
                        "Cubido.Template.slnx.xml": "Cubido.Template.slnx",
                        "tests/Application.FunctionalTests/Application.FunctionalTests.csproj.xml": "tests/Application.FunctionalTests/Application.FunctionalTests.csproj"
                    }
                }
            ]
        }
    ]
}
