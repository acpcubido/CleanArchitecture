{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Cubido.Template;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "Sqids": {
        "Alphabet": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    },
    "Cors": {
        "Origins": "http://localhost:4200"
    },
//#if (UseEntraIdAuthentication)
    "AzureAd": {
        "ClientId": "ClientIdToReplace",
        "Instance": "https://login.microsoftonline.com/",
//#if (UseCommonTenant)
        "TenantId": "common",
//#else
        "TenantId": "TenantIdToReplace",
//#endif
        "JwtTenantId": "TenantIdToReplace",
        "CallbackPath": "/signin-oidc",
        "Scope": [ "openid", "profile", "email", "User.Read" ],
        "ResponseType": "token id_token",
        "Audience": "AudienceId",
        "McpScope": "ScopeId"
    },
//#endif
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.AspNetCore.SpaProxy": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    }
}
